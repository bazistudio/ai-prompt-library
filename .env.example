# MongoDB Configuration
# For local development, e.g., mongodb://localhost:27017/ai-prompt-library
MONGODB_URI=mongodb://localhost:27017/ai-prompt-library

# Auth Session Configuration
# Must be a secure string of at least 32 characters in production
JWT_SECRET=development-only-jwt-secret-string-at-least-32-chars-long

# App Metadata
NEXT_PUBLIC_APP_NAME=AI Prompt Library

# SQLite Configuration (For Future Electron Integration)
# Defaults to ./prompt-library.db if not specified
SQLITE_DB_PATH=./prompt-library.db

# Test Credentials for App Testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123
