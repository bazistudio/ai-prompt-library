{
  "name": "ai-prompt-library",
  "version": "1.0.5",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed-test-user.mjs",
    "electron:compile": "tsup electron/main.ts electron/preload.ts --out-dir dist-electron --format cjs --no-splitting --external electron --external better-sqlite3 --external next",
    "electron:pack": "npm run build && npm run electron:compile && electron-builder --win dir"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "electron": "^34.5.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.bazistudio.ai-prompt-library",
    "productName": "AI Prompt Library",
    "copyright": "Copyright © 2026 BaziStudio",
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      ".next/**/*",
      "! .next/cache",
      "! .next/dev",
      "! .next/diagnostics",
      "! **/*.map",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "verifyUpdateCodeSignature": false
    }
  }
}